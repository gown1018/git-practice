// Arduino pin assignment
#define PIN_LED   9
#define PIN_TRIG  12
#define PIN_ECHO  13

// Configurable parameters
#define SND_VEL         346.0
#define INTERVAL        25       // sampling interval: 25 ms
#define PLOT_INTERVAL 100
#define PULSE_DURATION  10       // ultrasonic pulse duration: 10 us

#define DIST_MIN        100.0    // mm
#define DIST_CENTER     200.0    // mm
#define DIST_MAX        300.0    // mm

#define TIMEOUT ((INTERVAL / 2.0) * 1000.0)
#define SCALE   (0.001 * 0.5 * SND_VEL)

unsigned long last_sampling_time = 0;


// 초기 설정
void setup() {
  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);

  digitalWrite(PIN_TRIG, LOW);

  // Active low LED: 255 = 꺼짐
  analogWrite(PIN_LED, 255);

  Serial.begin(57600);
}


// 메인 반복문
void loop() {
  unsigned long now;
  float distance;
  float duty_float;
  int duty;

  now = millis();

  // 25ms마다 측정
  if (now - last_sampling_time < INTERVAL) {
    return;
  }

  last_sampling_time = now;

  // 초음파 거리 측정
  distance = USS_measure(PIN_TRIG, PIN_ECHO);

  /*
    Active low LED

    100mm -> duty 255 -> LED 꺼짐
    150mm -> duty 약 127 -> 밝기 50%
    200mm -> duty 0   -> 최대 밝기
    250mm -> duty 약 127 -> 밝기 50%
    300mm -> duty 255 -> LED 꺼짐
  */

  if (distance == 0.0 ||
      distance < DIST_MIN ||
      distance > DIST_MAX) {

    // 측정 실패 또는 측정 범위 밖
    duty = 255;
  }
  else {
    // 200mm에서 가장 밝고, 양쪽으로 멀어질수록 어두워짐
    duty_float = abs(distance - DIST_CENTER)
                 * 255.0
                 / (DIST_MAX - DIST_CENTER);

    duty = (int)duty_float;

    // duty 범위 제한
    if (duty < 0) {
      duty = 0;
    }

    if (duty > 255) {
      duty = 255;
    }
  }

  // LED 밝기 제어
  analogWrite(PIN_LED, duty);

  Serial.print("distance:");
  Serial.print(distance);
  Serial.print("\t");

  Serial.print("duty:");
  Serial.println(duty);
}


// 초음파 거리 측정 함수
// 반환값: mm 단위 거리
float USS_measure(int TRIG, int ECHO) {
  unsigned long duration;

  // 초음파 발사
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(PULSE_DURATION);
  digitalWrite(TRIG, LOW);

  // Echo HIGH 시간 측정
  duration = pulseIn(ECHO, HIGH, TIMEOUT);

  // Echo가 없으면 0 반환
  if (duration == 0) {
    return 0.0;
  }

  // 왕복 시간을 거리로 변환
  return duration * SCALE;
}
